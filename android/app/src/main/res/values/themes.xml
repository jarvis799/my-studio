<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.App" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="colorPrimary">@color/ink</item>
    </style>

    <style name="Field">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:padding">14dp</item>
        <item name="android:background">@drawable/field_bg</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textColorHint">@color/muted</item>
    </style>
</resources>
